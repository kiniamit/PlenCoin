# Coinbase CDP API key (Coinbase Developer Platform -> API keys -> "Secret API Key").
# Create it with View / read-only permissions - this app never trades.
#
# Copy to .env for local dev, or set these as CI / hosting environment variables.

# Looks like: organizations/<org-uuid>/apiKeys/<key-uuid>
COINBASE_API_KEY_NAME=

# Either:
#   - an EC private key PEM ("-----BEGIN EC PRIVATE KEY-----\nMHc...\n-----END EC PRIVATE KEY-----\n"), or
#   - a base64 Ed25519 key (a single ~88 character string)
# In a .env file keep it on one line and leave the \n escapes in place.
COINBASE_API_PRIVATE_KEY=

# Optional

# Set this to require a passphrase before anything is shown. Strongly advised
# if HOST is anything other than 127.0.0.1, because the pages expose your whole
# portfolio, cost basis and trade history.
APP_PASSPHRASE=

# Every value below is read literally to the end of the line, so do not put a
# comment after one - it becomes part of the value.

PORT=3000

# Bind address. 127.0.0.1 is this machine only; 0.0.0.0 makes it reachable from
# other devices on the network. Set APP_PASSPHRASE if you use 0.0.0.0.
# HOST=0.0.0.0

# How long a sign-in lasts, in days.
# SESSION_DAYS=30

# Serve sample data; no credentials needed.
# MOCK=1
